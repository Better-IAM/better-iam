{
  "name": "@better-iam/cli",
  "version": "0.1.0",
  "description": "The better-iam command line: migrations, bootstrap, scheduled jobs, audit and storage operations, diagnostics, and configuration as code.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Better IAM contributors",
  "homepage": "https://github.com/Better-IAM/better-iam/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Better-IAM/better-iam.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Better-IAM/better-iam/issues"
  },
  "keywords": [
    "iam",
    "authentication",
    "authorization",
    "access-control",
    "rbac",
    "abac",
    "multi-tenant",
    "cli",
    "migrations",
    "configuration-as-code",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@better-iam/core": "workspace:*",
    "@better-iam/server": "workspace:*",
    "@better-iam/client": "workspace:*",
    "@better-iam/adapter-sqlite": "workspace:*",
    "@better-iam/adapter-postgres": "workspace:*"
  },
  "bin": {
    "better-iam": "./dist/index.js"
  }
}
