{
  "name": "@better-iam/react",
  "version": "0.2.0",
  "description": "React bindings for Better IAM: a session store, hooks for the session and advisory authorization decisions, and a Can component.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Better IAM contributors",
  "homepage": "https://github.com/Better-IAM/better-iam/tree/main/packages/react#readme",
  "repository": {
