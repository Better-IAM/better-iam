{
  "name": "@better-iam/middleware",
  "version": "0.1.0",
  "description": "Express, Hono, and Fastify middleware for Better IAM: serve the IAM API, add per-request helpers, and guard routes with requireSession and authorize.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Better IAM contributors",
  "homepage": "https://github.com/Better-IAM/better-iam/tree/main/packages/middleware#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Better-IAM/better-iam.git",
    "directory": "packages/middleware"
  },
  "bugs": {
    "url": "https://github.com/Better-IAM/better-iam/issues"
  },
  "keywords": [
    "iam",
    "authentication",
    "authorization",
    "access-control",
    "rbac",
    "abac",
    "multi-tenant",
    "express",
    "hono",
    "fastify",
    "middleware",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@better-iam/client": "workspace:*",
    "@better-iam/core": "workspace:*"
  }
}
