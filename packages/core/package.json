{
  "name": "@better-iam/core",
  "version": "0.1.0",
  "description": "Browser-safe core of Better IAM: shared types, policy validation and evaluation, the audit chain verifier, and adapter and plugin contracts.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Better IAM contributors",
  "homepage": "https://github.com/Better-IAM/better-iam/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
