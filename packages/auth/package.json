{
  "name": "@better-iam/auth",
  "version": "0.1.0",
  "description": "Composable authentication, identity provisioning, and tenant-scoped access management.",
  "type": "module",
  "license": "MIT",
  "author": "Better IAM contributors",
  "homepage": "https://github.com/Better-IAM/better-iam/tree/main/packages/auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Better-IAM/better-iam.git",
    "directory": "packages/auth"
  },
  "bugs": {
    "url": "https://github.com/Better-IAM/better-iam/issues"
  },
  "keywords": [
    "iam",
    "authentication",
    "authorization",
    "access-control",
    "rbac",
    "abac",
    "multi-tenant",
    "passkeys",
    "webauthn",
    "mfa"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@better-iam/core": "workspace:*",
    "argon2": "^0.44.0",
    "otplib": "^12.0.1",
    "@simplewebauthn/server": "^13.2.2"
  }
