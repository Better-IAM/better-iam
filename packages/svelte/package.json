{
  "name": "@better-iam/svelte",
  "version": "0.1.0",
  "description": "SvelteKit and Svelte bindings for Better IAM: a handle hook that serves the IAM API, guarded loads and form actions, and session stores.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Better IAM contributors",
  "homepage": "https://github.com/Better-IAM/better-iam/tree/main/packages/svelte#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Better-IAM/better-iam.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/Better-IAM/better-iam/issues"
  },
  "keywords": [
    "iam",
    "authentication",
    "authorization",
    "access-control",
    "rbac",
    "abac",
    "multi-tenant",
    "svelte",
    "sveltekit",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@better-iam/client": "workspace:*",
    "@better-iam/core": "workspace:*",
    "@better-iam/middleware": "workspace:*"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.3",
    "svelte": "^5.57.1"
  }
}
