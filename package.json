{
  "name": "better-iam-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false && tsc -p tests/tsconfig.client.json && tsc -p tests/tsconfig.application.json && tsc -p tests/tsconfig.next.json && tsc -p tests/tsconfig.nestjs.json && tsc -p tests/tsconfig.svelte.json && tsc -p tests/tsconfig.middleware.json && tsc -p tests/tsconfig.react-router.json &&pnpm --filter @better-iam/console typecheck",
    "test": "vitest run",
    "test:postgres": "vitest run tests/postgres.test.ts tests/server-security.test.ts tests/adapter-conformance.test.ts tests/storage-query.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm validate:packages",
    "validate:packages": "node scripts/validate-packages.mjs",
    "pack:all": "node scripts/pack.mjs",
    "check:packed-types": "node scripts/check-packed-types.mjs",
    "test:packed": "node scripts/packed-smoke.mjs",
    "bench:scale": "vitest run --config vitest.bench.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:api": "node scripts/api-reference.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/platform-fastify": "^12.0.4",
    "@nestjs/testing": "^12.0.4",
    "@sveltejs/kit": "^2.70.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "express": "^5.2.1",
    "fastify": "^5.12.5",
    "h3": "^1.15.11",
    "hono": "^4.13.8",
    "happy-dom": "^17.6.3",
    "pnpm": "11.19.0",
    "prettier": "3.6.2",
    "publint": "^0.3.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.43"
  }
}
