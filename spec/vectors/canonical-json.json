{
  "description": "canonicalJson (audit hashing, receipts, evidence): JSON.stringify with every plain object rebuilt with its keys sorted by `<` (UTF-16 code units) and undefined members removed. Because it rebuilds JavaScript objects, integer-like keys (\"1\", \"10\") still come first in ascending numeric order, unlike RFC 8785. Arrays keep their order; undefined array entries become null; non-finite numbers become null.",
  "source": "packages/core/src/audit.ts#canonicalJson",
  "cases": [
    {
      "name": "primitives",
      "input": {
        "value": [
          null,
          true,
          1,
          "x"
        ]
      },
      "output": "[null,true,1,\"x\"]"
    },
    {
      "name": "key order",
      "input": {
        "value": {
          "b": 1,
          "a": 2,
          "c": {
            "z": 1,
            "y": 2
          }
        }
      },
      "output": "{\"a\":2,\"b\":1,\"c\":{\"y\":2,\"z\":1}}"
    },
    {
      "name": "integer-like keys first",
      "input": {
        "value": {
          "2": "two",
          "10": "ten",
          "b": 1,
          "a": 2,
          "01": "zero-one"
        }
      },
      "output": "{\"2\":\"two\",\"10\":\"ten\",\"01\":\"zero-one\",\"a\":2,\"b\":1}"
    },
    {
      "name": "utf-16 key order",
      "input": {
        "value": {
          "€": 1,
          "ö": 2,
          "😀": 3,
          "דּ": 4,
          "A": 5,
          "a": 6
        }
      },
      "output": "{\"A\":5,\"a\":6,\"ö\":2,\"€\":1,\"😀\":3,\"דּ\":4}"
    },
    {
      "name": "undefined members dropped",
      "input": {
        "value": {
          "a": {
            "$undefined": true
          },
          "b": {
            "c": {
              "$undefined": true
            },
            "d": 1
          }
        }
      },
      "output": "{\"b\":{\"d\":1}}"
    },
    {
      "name": "undefined array entries",
      "input": {
        "value": [
          1,
          {
            "$undefined": true
          },
          3
        ]
      },
      "output": "[1,null,3]"
    },
    {
      "name": "non-finite numbers",
      "input": {
        "value": {
          "a": {
            "$number": "NaN"
          },
          "b": {
            "$number": "Infinity"
          }
        }
      },
      "output": "{\"a\":null,\"b\":null}"
    },
    {
      "name": "nested arrays of objects",
      "input": {
        "value": [
          {
            "b": 1,
            "a": 2
          },
          [
            {
              "d": 1,
              "c": 2
            }
          ]
        ]
      },
      "output": "[{\"a\":2,\"b\":1},[{\"c\":2,\"d\":1}]]"
    },
    {
      "name": "empty",
      "input": {
        "value": {}
      },
      "output": "{}"
    },
    {
      "name": "audit event",
      "input": {
        "value": {
          "id": "evt_1",
          "tenantId": "tnt_1",
          "actorId": "idn_1",
          "action": "iam:groups:create",
          "resourceId": "grp_1",
          "outcome": "allow",
          "rootOverride": false,
          "timestamp": 1767225600000,
          "metadata": {
            "z": 1,
            "a": [
              2,
              1
            ]
          }
        }
      },
      "output": "{\"action\":\"iam:groups:create\",\"actorId\":\"idn_1\",\"id\":\"evt_1\",\"metadata\":{\"a\":[2,1],\"z\":1},\"outcome\":\"allow\",\"resourceId\":\"grp_1\",\"rootOverride\":false,\"tenantId\":\"tnt_1\",\"timestamp\":1767225600000}"
    }
  ]
}
