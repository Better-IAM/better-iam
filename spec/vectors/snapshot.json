{
  "description": "Store snapshots (JSON Lines): a header {\"format\":\"better-iam-store\",\"version\":1,\"createdAt\":<ISO time>,\"collections\":[sorted names]}, one {\"c\":collection,\"r\":record} line per record (collections in order, records by id in code-point order), and a trailer {\"end\":true,\"records\":n,\"collections\":{name:count}}. importStore loads a snapshot into an empty store in one transaction and refuses malformed input.",
  "source": "packages/core/src/snapshot.ts#exportStore,importStore",
  "notes": {
    "format": "better-iam-store",
    "version": 1
  },
  "cases": [
    {
      "name": "export all collections",
      "input": {
        "records": {
          "tenants": [
            {
              "id": "tnt_b",
              "tenantId": "tnt_b",
              "name": "B"
            },
            {
              "id": "tnt_a",
              "tenantId": "tnt_a",
              "name": "A",
              "uniqueKey": "a"
            }
          ],
          "identities": [
            {
              "id": "idn_2",
              "tenantId": "tnt_a",
              "email": "b@example.com"
            },
            {
              "id": "idn_10",
              "tenantId": "tnt_a",
              "email": "a@example.com",
              "attributes": {
                "team": "eng"
              }
            },
            {
              "id": "idn_😀",
              "tenantId": "tnt_a",
              "email": "c@example.com"
            }
          ],
          "auditChains": [
            {
              "id": "tnt_a",
              "tenantId": "tnt_a",
              "sequence": 2,
              "hash": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
              "updatedAt": 1767225600000
            }
          ]
        }
      },
      "output": {
        "lines": [
          "{\"format\":\"better-iam-store\",\"version\":1,\"createdAt\":\"2026-01-01T00:00:00.000Z\",\"collections\":[\"auditChains\",\"identities\",\"tenants\"]}",
          "{\"c\":\"auditChains\",\"r\":{\"id\":\"tnt_a\",\"tenantId\":\"tnt_a\",\"sequence\":2,\"hash\":\"ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\",\"updatedAt\":1767225600000}}",
          "{\"c\":\"identities\",\"r\":{\"id\":\"idn_10\",\"tenantId\":\"tnt_a\",\"email\":\"a@example.com\",\"attributes\":{\"team\":\"eng\"}}}",
          "{\"c\":\"identities\",\"r\":{\"id\":\"idn_2\",\"tenantId\":\"tnt_a\",\"email\":\"b@example.com\"}}",
          "{\"c\":\"identities\",\"r\":{\"id\":\"idn_😀\",\"tenantId\":\"tnt_a\",\"email\":\"c@example.com\"}}",
          "{\"c\":\"tenants\",\"r\":{\"id\":\"tnt_a\",\"tenantId\":\"tnt_a\",\"name\":\"A\",\"uniqueKey\":\"a\"}}",
          "{\"c\":\"tenants\",\"r\":{\"id\":\"tnt_b\",\"tenantId\":\"tnt_b\",\"name\":\"B\"}}",
          "{\"end\":true,\"records\":6,\"collections\":{\"auditChains\":1,\"identities\":3,\"tenants\":2}}"
        ],
        "summary": {
          "records": 6,
          "collections": {
            "auditChains": 1,
            "identities": 3,
            "tenants": 2
          }
        }
      }
    },
